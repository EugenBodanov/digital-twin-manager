[
  {
    "condition": "room-1.temperatureSensor.temperature > INTEGER(80)",
    "action": {
      "type": "lambda",
      "functionName": "alertAction",
      "external": true,
      "feedback": {
        "type": "mqtt",
        "iotDeviceId": "sensor-2",
        "payload": "action-result"
      },
      "inputParameters": [
        {
          "name": "threshold",
          "dataType": "INTEGER",
          "id": "room-1.temperatureSensor.threshold",
          "value": 80
        }
      ],
      "outputParameters": [
        {
          "name": "status",
          "dataType": "STRING"
        }
      ]
    }
  }
]
