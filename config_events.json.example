[
    {
        "condition": "4udMBA6jAnnRf33MNHHP9P.p16.isPlugged == 4udMBA6jAnnRf33MNHHP9P.Batteryconst_component.trueValue",
        "action": {
            "type": "lambda",
            "pathToCode": "./lambda_functions/event_actions/high-temperature-callback",
            "functionName": "status",
            "external": false,
            "feedback": {
                "type": "mqtt",
                "topic": "Battery/iot-data",
                "payload": "action-result"
            },
            "inputParameters": [
                {
                    "name": "chargeValue",
                    "dataType": "INTEGER",
                    "id": "4udMBA6jAnnRf33MNHHP9P.p16.charges"
                }
            ],
            "outputParameters": []
        }
    }
]
